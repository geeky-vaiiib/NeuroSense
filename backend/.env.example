# NeuroSense Backend — Environment Variables
#
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is listed in .gitignore.
#
# ─────────────────────────────────────────────────────────────────────────────
# MongoDB Atlas
# ─────────────────────────────────────────────────────────────────────────────
# Full Atlas connection string (SRV format).
# Replace <user>, <password>, and <cluster> with your real Atlas credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=NeuroSense

# The database that NeuroSense will use inside your Atlas cluster.
MONGODB_DB_NAME=neurosense

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (all required unless a default is shown)
# ─────────────────────────────────────────────────────────────────────────────
# Random signing secret, >= 32 chars. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start if this is missing, short, or a placeholder.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=neurosense
JWT_AUDIENCE=neurosense-app

# Session cookie. Set COOKIE_SECURE=true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated frontend origins allowed to call the API with credentials ("*" is rejected).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Gaze: OpenFace 2.x runs in Docker (amd64, emulated on Apple silicon). Pull once: docker pull --platform linux/amd64 algebr/openface
OPENFACE_DOCKER_IMAGE=algebr/openface
