# NeuroSense Backend — Environment Variables
#
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is listed in .gitignore.
#
# ─────────────────────────────────────────────────────────────────────────────
# MongoDB Atlas
# ─────────────────────────────────────────────────────────────────────────────
# Full Atlas connection string (SRV format).
# Replace <user>, <password>, and <cluster> with your real Atlas credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=NeuroSense

# The database that NeuroSense will use inside your Atlas cluster.
MONGODB_DB_NAME=neurosense
